---
import Layout from '../../components/Layout.astro';
import Search from '../../components/Search.astro';
import data from '../../data/products.json';
import {tradeQuery} from '../../lib/trade';
import { url } from '../../lib/site';
import { languages, namedPartners, percent, t, type Language, type Product } from '../../lib/ui';
export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Language;
const products = data as Product[];
const leaders = products.flatMap((product) => {
  const year = product.years.at(-1);
  const partner = year && namedPartners(year)[0];
  return year && partner && year.top1 !== null ? [{ product, year, partner, share: year.top1 }] : [];
}).sort((a,b) => b.share - a.share).slice(0,5);
const h = (key: string) => t(lang, `home.${key}`);
---
<Layout lang={lang} path="" title={h('scope')} description={h('intro')}>
  <section class="home-hero">
    <div class="wrap hero">
      <div>
        <p class="eyebrow">{h('scope')} · {t(lang,'footer.independent')}</p>
        <h1>{h('title')}</h1>
        <p class="lede">{h('intro')}</p>
        <Search lang={lang} examples />
      </div>
      <img class="hero-art" src={url('pump-illustration.svg')} width="480" height="400" alt="" />
    </div>
  </section>
  <section class="section-block wrap home-steps">
    <h2>{h('how')}</h2>
    <ol role="list">
      {[1,2,3].map((n) => <li><strong>{h(`step${n}`)}</strong><span>{h(`step${n}body`)}</span></li>)}
    </ol>
  </section>
  <section class="section-block wrap">
    <h2>{h('concentration')}</h2>
    <p class="source-note">{h('concentrationNote')}</p>
    {leaders.length ? <ul class="home-rank">
      {leaders.map(({product, year, partner, share}) => <li>
        <a class="touch-link" href={url(`${lang}/product/${product.hs6}/`)}>{product.name[lang]}</a>
        <span><bdi>{partner.name[lang]}</bdi> · <bdi>{percent(share,lang)}</bdi> · <bdi>{year.year}</bdi></span>
        <svg class="rank-share" viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true"><rect class="bar-fill" x={lang === 'ar' ? 100 - share * 100 : 0} y="0" width={share * 100} height="8" /></svg>
        <small class="source-note"><a href={tradeQuery(product.hs6,year.year)} rel="noopener noreferrer">{t(lang,'product.comtradeShort')}</a>{(year.accessed ?? product.source.accessed) && <> · {t(lang,'browse.atDate')}{' '}<bdi dir="ltr">{year.accessed ?? product.source.accessed}</bdi></>}</small>
      </li>)}
    </ul> : <p class="notice">{t(lang,'common.pending')}</p>}
    <a class="touch-link" href={url(`${lang}/about/`)}>{h('free')}</a>
  </section>
</Layout>
